<UserControl x:Class="EncodePreviewPlugin.Views.EncodePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:EncodePreviewPlugin.ViewModels"
             mc:Ignorable="d" 
             Background="#1E1E1E" Foreground="#CCCCCC"
             FontFamily="Segoe UI, Yu Gothic UI">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        
        <!-- Style for Progress Bar -->
        <Style x:Key="EncodeProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#00BC7D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="0"/>
                            <Border x:Name="PART_Indicator" Background="#00BC7D" HorizontalAlignment="Left" CornerRadius="0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" Width="{Binding PreviewAreaWidth}">
        <!-- Header / Status Area -->
        <Border Background="#252526" BorderBrush="#333337" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Status Indicator Dot -->
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEncoding}" Value="True">
                                        <Setter Property="Fill" Value="#00BC7D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FrameText}" Margin="10,0,0,0" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- FPS Badge -->
                    <Border Background="#333337" CornerRadius="3" Padding="5,1">
                        <TextBlock Text="{Binding RenderedFps, StringFormat='UI: {0} fps'}" FontSize="9" Foreground="#AAAAAA"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Preview Area with exact aspect ratio size -->
        <Grid Width="{Binding PreviewAreaWidth}" Height="{Binding PreviewAreaHeight}" Background="#111111" ClipToBounds="True">
            <!-- Checkerboard for transparency supported video -->
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.25"
                    Visibility="{Binding ShowCheckerboard, Converter={StaticResource BoolToVis}}">
                <Canvas.Background>
                    <DrawingBrush Viewport="0,0,16,16" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#444444">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,8,8"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#444444">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="8,8,8,8"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>

            <!-- Video Background Fill (for non-transparent video like MP4) -->
            <Border Background="{Binding VideoBackgroundBrush}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCheckerboard}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Rendered Frame Image - perfectly fills the exact aspect ratio frame -->
            <Image Source="{Binding PreviewImage}" 
                   Stretch="Fill" 
                   HorizontalAlignment="Stretch" 
                   VerticalAlignment="Stretch"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Idle Placeholder -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasFrame}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4M4,6V18H20V6H4M6,8H8V10H6V8M6,12H8V14H6V12M6,16H8V18H6V16M16,8H18V10H16V8M16,12H18V14H16V12M16,16H18V18H16V16M10,8H14V18H10V8Z"
                          Fill="#444444" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="動画出力が開始されるとプレビューが表示されます" 
                               Foreground="#666666" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Progress Bar -->
        <ProgressBar Value="{Binding Progress, Mode=OneWay}" 
                     Maximum="100" 
                     Style="{StaticResource EncodeProgressBarStyle}" />

        <!-- Footer Info -->
        <Border Background="#252526" BorderBrush="#333337" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResolutionText, StringFormat='解像度: {0}'}" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Encode Preview" FontSize="10" Foreground="#555555" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
